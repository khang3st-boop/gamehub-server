# Sao chép thành .env rồi điền giá trị THẬT. KHÔNG commit file .env.
GAMEHUB_DOMAIN=game.ten-mien-cua-ban.vn
DB_USER=gamehub
# Tạo mật khẩu ngẫu nhiên, ví dụ:  openssl rand -base64 24
DB_PASSWORD=
# Khoá ký JWT >= 32 ký tự, ví dụ:  openssl rand -base64 48
GAMEHUB_JWT_SECRET=
# Bật Swagger trên production (mặc định tắt)
GAMEHUB_SWAGGER=false
# Thư mục Flutter Web đã build (scripts/update-web.sh chép vào backend/web) — tính từ thư mục deploy/
WEB_ROOT=../web
